// use prisma-8

enum userRole {
  @@type("pg/text@1")
  STUDENT = "student"
  STAFF = "staff"
  ADMIN = "admin"  
}

enum dept {
  @@type("pg/text@1")
  COMPUTER_SCIENCE = "computer science"
  SOFTWARE_ENGINEERING = "software engineering"
  DATA_SCIENCE = "data science"
  CYBERSECURITY = "cybersecurity"
}

enum modeOfEntry {
  @@type("pg/text@1")
  UTME = "utme"
  TRANSFER = "transfer"
  DIRECT_ENTRY = "direct entry"  
}

enum uploadStatus {
  @@type("pg/text@1")
  PENDING = "pending"
  APPROVED = "approved"
  REJECTED = "rejected"
}

enum registrationStatus {
  @@type("pg/text@1")
  NOT_STARTED = "not started"
  ONGOING = "ongoing"
  COMPLETED = "completed"
  FAILED = "failed"
}

enum stuCategory {
  @@type("pg/text@1")
  FRESHER = "fresher"
  RETURNING = "returning"
  FINALIST = "finalist"
}


model User {
  id  Int @id @default(autoincrement())
  email String  @unique
  firstName String
  lastName  String
  password  String
  createdAt DateTime  @default(now())
  isActive  Boolean
  mustResetPassword Boolean
  passwordRestAt  DateTime?
  role  userRole  @default(ADMIN)

  //Back-relations to child 
  student Student?
  staff   Staff?
}


model Student {
  id  Int @id @default(autoincrement())
  matric_no String @unique
  department  dept
  level Int
  mode_of_entry modeOfEntry @default(UTME)
  graduated Boolean
  categoryId  Int?
  academicSession String?
  userId  Int @unique
  departmentId  Int

  //relations
  documents Document[]
  notifications Notification[]
  registrations Registration[]
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dept  Department  @relation(fields: [departmentId], references: [id])
}


model Staff {
  id  Int @id @default(autoincrement())
  staffId String
  userId  Int @unique

  //relations
  documents Document[]
  notifications Notification[]
  user User @relation(fields: [userId], references: [id])
}


model Department {
  id  Int @id @default(autoincrement())
  department  dept
  max_level Int

  //relations
  students  Student[] 
}

model Document {
  id  Int @id  @default(autoincrement())
  documentType  String
  fileName  String
  filePath  String
  status  uploadStatus @default(PENDING)
  uploadDate  DateTime  @default(now())
  reviewDate  DateTime?
  comment String?
  lockedBy  Int?
  lockedAt  DateTime?
  studentId Int
  staffId Int
  sessionId Int

  //relations
  student Student @relation(fields: [studentId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
}


model Session {
  id  Int @id @default(autoincrement())
  sessionId String  @unique
  isActive  Boolean
  startDate DateTime
  endDate   DateTime?

  //relations
  registrations Registration[]
  documents Document[]
}


model Registration {
  id  Int @id @default(autoincrement())
  status  registrationStatus @default(NOT_STARTED)
  dateRegistered  DateTime?
  studentId Int @unique
  sessionId Int @unique

  //relations
  student Student @relation(fields: [studentId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
}


model studentCategories{
  id  Int @id @default(autoincrement())
  category  stuCategory

  //relations
  reqDocs requiredDocuments[]
}


model requiredDocuments {
  id  Int @id @default(autoincrement())
  name  String
  isActive  Boolean

  //relations
  stuCategory studentCategories[]
}

model requiredDocumentsMAPstudentCategories {
  stuCategoryId Int
  reqDocsId Int
  category  studentCategories @relation(fields: [stuCategoryId], references: [id])
  docs  requiredDocuments @relation(fields: [reqDocsId], references: [id])

  @@id([stuCategoryId, reqDocsId])
}


model Notification {
  id  Int @id @default(autoincrement())
  title String
  message String
  createdAt DateTime  @default(now())
  isRead  Boolean
  studentId Int
  staffId Int

  //relations
  student Student @relation(fields: [studentId], references: [id])
  staff Staff @relation(fields: [staffId], references: [id])
}