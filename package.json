{
  "name": "dms-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:shared": "npm run dev -w @shared/types",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build:all": "npm run build -w @shared/types && npm run build -w backend -w frontend"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "@nestjs/cli": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}